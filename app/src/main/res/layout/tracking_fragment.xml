<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0D1A"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="40dp">

        <!-- ===== Gradient background overlay ===== -->
        <View
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/tracking_bg_gradient"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ===== Icon người đi bộ lớn ở trung tâm ===== -->
        <ImageView
            android:id="@+id/ivFollowIcon"
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_auto_follow_24"
            android:alpha="0.15"
            android:layout_marginTop="60dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===== Title ===== -->
        <TextView
            android:id="@+id/tvTrackingTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Theo Dõi Tự Động"
            android:textColor="#E8E8F0"
            android:textSize="22sp"
            android:fontFamily="sans-serif-medium"
            android:letterSpacing="0.03"
            app:layout_constraintTop_toBottomOf="@id/ivFollowIcon"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===== Subtitle ===== -->
        <TextView
            android:id="@+id/tvTrackingSubtitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="40dp"
            android:layout_marginEnd="40dp"
            android:text="Bật các tính năng AI để robot tự động bám theo người và phát hiện té ngã"
            android:textColor="#7E7E9A"
            android:textSize="13sp"
            android:gravity="center"
            android:lineSpacingMultiplier="1.4"
            app:layout_constraintTop_toBottomOf="@id/tvTrackingTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===== Card chứa nút toggle chính ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardToggle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="36dp"
            app:cardBackgroundColor="#1A1A2E"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeColor="#2A2A45"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/tvTrackingSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Row: icon + label + switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Icon circle -->
                    <FrameLayout
                        android:id="@+id/frameFollowIconBg"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/tracking_bg_icon_circle">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_auto_follow_24" />
                    </FrameLayout>

                    <!-- Text -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Bám Theo Người"
                            android:textColor="#E8E8F0"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:id="@+id/tvFollowModeDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Đang tắt"
                            android:textColor="#5E5E7A"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Toggle Switch -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchAutoFollow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:thumbTint="#FFFFFF"
                        app:trackTint="@drawable/tracking_switch_track" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="#22224A" />

                <!-- Status badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/viewStatusDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/tracking_dot_inactive" />

                    <TextView
                        android:id="@+id/tvFollowStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="Robot đang chờ lệnh"
                        android:textColor="#5E5E7A"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvFirebaseStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Đã kết nối"
                        android:textColor="#4CAF50"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Card: Phát Hiện Té Ngã (LSTM AI) ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardFallDetection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="12dp"
            app:cardBackgroundColor="#1A1A2E"
            app:cardCornerRadius="20dp"
            app:cardElevation="8dp"
            app:strokeColor="#2A2A45"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/cardToggle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Row: icon + label + switch -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Icon circle -->
                    <FrameLayout
                        android:id="@+id/frameFallIconBg"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@drawable/tracking_bg_fall_icon_circle">
                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_gravity="center"
                            android:contentDescription="Phát hiện té ngã"
                            android:src="@drawable/ic_person_falling_24"
                            android:tint="#E53935" />
                    </FrameLayout>

                    <!-- Text -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:layout_marginStart="16dp">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Phát Hiện Té Ngã (AI)"
                            android:textColor="#E8E8F0"
                            android:textSize="15sp"
                            android:fontFamily="sans-serif-medium" />
                        <TextView
                            android:id="@+id/tvFallDetectionDesc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Đang tắt"
                            android:textColor="#5E5E7A"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <!-- Toggle Switch -->
                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/switchFallDetection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="false"
                        app:thumbTint="#FFFFFF"
                        app:trackTint="@drawable/tracking_switch_track" />
                </LinearLayout>

                <!-- Divider -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="20dp"
                    android:layout_marginBottom="20dp"
                    android:background="#22224A" />

                <!-- Status badge -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:id="@+id/viewFallDetectionDot"
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/tracking_dot_inactive" />

                    <TextView
                        android:id="@+id/tvFallDetectionStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:text="YOLO + LSTM đang tắt"
                        android:textColor="#5E5E7A"
                        android:textSize="12sp" />

                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="16dp"
            app:cardBackgroundColor="#12122A"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeColor="#1E1E3A"
            app:strokeWidth="1dp"
            app:layout_constraintTop_toBottomOf="@id/cardFallDetection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- Hàng 1 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="12dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_lock_24"
                        app:tint="#7070A0" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Robot tự lock và bám theo 1 người cố định"
                        android:textColor="#7070A0"
                        android:textSize="12sp" />
                </LinearLayout>

                <!-- Hàng 2 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:src="@drawable/ic_stop_24"
                        app:tint="#7070A0" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="Tắt công tắc để robot dừng ngay lập tức"
                        android:textColor="#7070A0"
                        android:textSize="12sp" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
