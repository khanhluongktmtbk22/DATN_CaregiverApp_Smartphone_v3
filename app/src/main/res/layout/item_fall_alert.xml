<?xml version="1.0" encoding="utf-8"?>
<!--
    item_fall_alert.xml  — Card một cảnh báo té ngã

    Layout:
    ┌─────────────────────────────────────────────────────────┐
    │  [người ngã]  Phát hiện té ngã     [92%]   14/08 15:30 │
    │  icon  ←tiêu đề trạng thái→        xác suất  ngày giờ  │
    └─────────────────────────────────────────────────────────┘
-->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginTop="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="1dp"
    app:cardBackgroundColor="#FFFFFF"
    app:strokeColor="#E4E8F0"
    app:strokeWidth="1dp">

    <!-- Left border màu đỏ/cam -->
    <View
        android:layout_width="4dp"
        android:layout_height="match_parent"
        android:id="@+id/viewAlertBar"
        android:background="#FFEE3333" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingStart="18dp"
        android:paddingEnd="16dp"
        android:paddingTop="14dp"
        android:paddingBottom="14dp"
        android:gravity="center_vertical">

        <!-- Biểu tượng sự kiện té ngã/tư thế nằm -->
        <FrameLayout
            android:id="@+id/frameAlertIcon"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_fall_alert_icon">

            <ImageView
                android:id="@+id/ivAlertIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:contentDescription="Biểu tượng cảnh báo té ngã"
                android:src="@drawable/ic_person_falling_24"
                app:tint="#D9363E" />

        </FrameLayout>

        <!-- Text info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="14dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAlertState"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Phát hiện té ngã"
                android:textColor="#B4232C"
                android:textSize="15sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Badge xác suất -->
                <TextView
                    android:id="@+id/tvAlertProb"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="9dp"
                    android:paddingVertical="4dp"
                    android:text="92%"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/ic_status_badge_fall" />

                <TextView
                    android:id="@+id/tvAlertTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="14/08/2026  15:30"
                    android:textColor="#667085"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
